{
  "name": "@govuk-once/flex-domain-sdk",
  "version": "0.1.0",
  "description": "Declares a Flex domain's routes and handler types.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "directory": "dist",
    "linkDirectory": false
  },
  "scripts": {
    "build": "rolldown -c",
    "lint": "eslint src/ test/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "pino": "10.4.0"
  },
  "peerDependencies": {
    "@govuk-once/flex-gateway-client": ">=0.1.0 <1.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@govuk-once/flex-gateway-client": "workspace:*",
    "@repo/cloudfront-js-utils": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@repo/utils": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "eslint": "10.14.0",
    "rolldown": "1.3.2",
    "rolldown-plugin-dts": "0.30.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
