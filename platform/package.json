{
  "name": "@repo/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "synth": "cdk synth --quiet",
    "diff": "cdk diff",
    "deploy": "cdk deploy --all --require-approval never",
    "destroy": "cdk destroy --all --force",
    "checkov": "rm -rf cdk.out && cdk synth --quiet && checkov --config-file checkov.yaml",
    "lint": "eslint src/ test/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "aws-cdk-lib": "2.261.0",
    "constructs": "10.7.1"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "3.1135.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1135.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "aws-cdk": "2.1132.0",
    "eslint": "10.10.0",
    "tsx": "4.23.13",
    "vitest": "5.0.1"
  }
}
