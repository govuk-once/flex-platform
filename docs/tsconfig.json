{
  "extends": "astro/tsconfigs/strict",
  // The two flags in the repository's own base that change what strict code may assume about a
  // value, so the site's code is held to the same.
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
