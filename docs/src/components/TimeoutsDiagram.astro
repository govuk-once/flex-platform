---
// How long each part of a request waits, from the edge to an upstream attempt, drawn as bars on
// one scale of seconds so each limit is seen to sit inside the one before it.
import Diagram from "./Diagram.astro";
---

<Diagram title="How long each part waits" minWidth={600} maxWidth={900}>
  <svg
    viewBox="0 0 900 570"
    role="img"
    aria-labelledby="timeouts-title timeouts-desc"
  >
    <title id="timeouts-title">How long each part waits</title>
    <desc id="timeouts-desc">
      Bars on one scale of 0 to 30 seconds, each inside the one before it. CloudFront waits 30
      seconds to read the domain's answer, since API Gateway's own limit is 29 seconds. Lambda@Edge
      sets that limit on the origin, and has returned before the request leaves. The domain
      function's timeout is 29 seconds. The domain SDK's deadline is the time the invocation has
      left, less 500 milliseconds, and the gateway client shares it. The gateway function's
      timeout is 28 seconds. The gateway's request budget is the time its invocation has left, less
      500 milliseconds. Each upstream attempt has the policy's upstreamTimeout, 10 seconds by
      default, or the budget left, whichever is smaller.
    </desc>

    <!-- Frontdoor -->
    <rect class="section" x="20" y="20" width="860" height="78" rx="10"></rect>
    <text class="note" x="36" y="42">Frontdoor</text>
    <text class="label start" x="36" y="74">CloudFront's read timeout</text>
    <rect class="bar" x="310" y="54" width="540" height="30"></rect>
    <text class="value" x="840" y="74">30 s</text>

    <!-- Domain -->
    <rect class="section" x="20" y="110" width="860" height="182" rx="10"></rect>
    <text class="note" x="36" y="132">Domain</text>
    <text class="label start" x="36" y="164">API Gateway's limit</text>
    <rect class="bar" x="310" y="144" width="522" height="30"></rect>
    <text class="value" x="822" y="164">29 s</text>

    <text class="label start" x="36" y="208">Domain function's timeout</text>
    <rect class="bar" x="310" y="188" width="522" height="30"></rect>
    <text class="value" x="822" y="208">29 s</text>

    <text class="label start" x="36" y="248">Domain SDK's deadline</text>
    <text class="note" x="36" y="268">shared by the gateway client</text>
    <rect class="bar accent" x="310" y="232" width="513" height="30"></rect>
    <text class="value" x="813" y="252">time left, less 500 ms</text>

    <!-- Gateway -->
    <rect class="section" x="20" y="304" width="860" height="182" rx="10"></rect>
    <text class="note" x="36" y="326">Gateway</text>
    <text class="label start" x="36" y="358">Gateway function's timeout</text>
    <rect class="bar" x="310" y="338" width="504" height="30"></rect>
    <text class="value" x="804" y="358">28 s</text>

    <text class="label start" x="36" y="402">Gateway's request budget</text>
    <rect class="bar accent" x="310" y="382" width="495" height="30"></rect>
    <text class="value" x="795" y="402">time left, less 500 ms</text>

    <text class="label start" x="36" y="442">Each upstream attempt</text>
    <text class="note mono" x="36" y="462">upstreamTimeout</text>
    <rect class="bar accent" x="310" y="426" width="180" height="30"></rect>
    <text class="value" x="480" y="446">10 s by default</text>
    <text class="note" x="500" y="446">or the budget left, if that is smaller</text>

    <!-- Axis -->
    <line class="axis" x1="310" y1="506" x2="850" y2="506"></line>
    <line class="axis" x1="310" y1="500" x2="310" y2="512"></line>
    <line class="axis" x1="400" y1="500" x2="400" y2="512"></line>
    <line class="axis" x1="490" y1="500" x2="490" y2="512"></line>
    <line class="axis" x1="580" y1="500" x2="580" y2="512"></line>
    <line class="axis" x1="670" y1="500" x2="670" y2="512"></line>
    <line class="axis" x1="760" y1="500" x2="760" y2="512"></line>
    <line class="axis" x1="850" y1="500" x2="850" y2="512"></line>
    <text class="sub" x="310" y="532">0 s</text>
    <text class="sub" x="400" y="532">5</text>
    <text class="sub" x="490" y="532">10</text>
    <text class="sub" x="580" y="532">15</text>
    <text class="sub" x="670" y="532">20</text>
    <text class="sub" x="760" y="532">25</text>
    <text class="sub" x="850" y="532">30</text>
  </svg>
  <Fragment slot="caption">
    Each bar is drawn from 0, though each part starts a little after the one above it.
  </Fragment>
</Diagram>

<style>
  .bar {
    fill: var(--sl-color-bg);
    stroke: var(--sl-color-gray-4);
    stroke-width: 1;
  }
  .bar.accent {
    stroke: var(--sl-color-accent);
    stroke-width: 1.5;
  }
  .value {
    font-size: 13px;
    font-weight: 600;
    text-anchor: end;
  }
  .axis {
    stroke: var(--sl-color-gray-3);
    stroke-width: 1.5;
  }
</style>
