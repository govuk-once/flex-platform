---
// How a gateway's configuration becomes a running gateway and a domain's types: the two
// commands, what each reads and writes, and where each half of `.gen/` goes. Drawn with
// Starlight's colour variables so it follows the light and dark themes.
import Diagram from "./Diagram.astro";
---

<Diagram title="From configuration to a running gateway" minWidth={520} maxWidth={780}>
  <svg
    viewBox="0 0 780 720"
    role="img"
    aria-labelledby="gateway-build-title gateway-build-desc"
  >
    <title id="gateway-build-title">From configuration to a running gateway</title>
    <desc id="gateway-build-desc">
      At build time, gateway-schemas, which a person runs and which uses the network, reads the
      gateway's gateway.config.ts and the upstream's own description, if it has one. For
      openapi-rest, the description is the OpenAPI document its spec names. gateway-schemas
      writes the next schema version, schemas/000N.json, which a person reviews and commits.
      gateway-codegen runs locally and in CI with the network refused. It loads the
      configuration and the latest schema version, checks them in stages, and writes .gen/. Its
      runtime half, .gen/runtime/, holds the validators, entry.js and bundle.mjs. Its client
      half, .gen/client/, holds rpc.ts, index.ts and the client package. At run time, the
      gateway's stack deploys the bundle as the gateway's Lambda function, and a domain installs
      the client package and invokes the gateway through it.
    </desc>
    <defs>
      <marker
        id="gateway-build-arrow"
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M0,0 L10,5 L0,10 z" class="head"></path>
      </marker>
    </defs>

    <!-- Inputs -->
    <rect class="box" x="60" y="10" width="280" height="72" rx="6"></rect>
    <text class="label mono" x="200" y="42">gateway.config.ts</text>
    <text class="sub" x="200" y="63">operations, driver and policy</text>

    <rect class="external" x="440" y="10" width="280" height="72" rx="6"></rect>
    <text class="label" x="580" y="34">The upstream's description</text>
    <text class="sub" x="580" y="54">if it has one; for openapi-rest,</text>
    <text class="sub" x="580" y="71">the OpenAPI document <tspan class="mono">spec</tspan> names</text>

    <!-- Build time -->
    <rect class="section" x="20" y="100" width="740" height="446" rx="10"></rect>
    <text class="section-title" x="36" y="128">Build time</text>

    <rect class="box" x="240" y="146" width="300" height="56" rx="6"></rect>
    <text class="label mono" x="390" y="170">gateway-schemas</text>
    <text class="sub" x="390" y="190">a person runs it · uses the network</text>

    <rect class="box" x="240" y="242" width="300" height="56" rx="6"></rect>
    <text class="label mono" x="390" y="266">schemas/000N.json</text>
    <text class="sub" x="390" y="286">reviewed and committed</text>

    <rect class="box accent" x="60" y="338" width="660" height="72" rx="6"></rect>
    <text class="label mono" x="390" y="362">gateway-codegen</text>
    <text class="sub" x="390" y="382">runs locally and in CI, with the network refused</text>
    <text class="sub" x="390" y="400">checks in stages, then writes .gen/</text>

    <rect class="box" x="60" y="450" width="280" height="64" rx="6"></rect>
    <text class="label mono" x="200" y="476">.gen/runtime/</text>
    <text class="sub" x="200" y="498">validators · entry.js · bundle.mjs</text>

    <rect class="box" x="440" y="450" width="280" height="64" rx="6"></rect>
    <text class="label mono" x="580" y="476">.gen/client/</text>
    <text class="sub" x="580" y="498">rpc.ts · index.ts · client package</text>

    <!-- Run time -->
    <rect class="section" x="20" y="576" width="740" height="130" rx="10"></rect>
    <text class="section-title" x="36" y="604">Run time</text>

    <rect class="box accent" x="60" y="626" width="280" height="56" rx="6"></rect>
    <text class="label" x="200" y="650">Lambda function</text>
    <text class="sub" x="200" y="670">bundle.handler · egress section</text>

    <rect class="box" x="440" y="626" width="280" height="56" rx="6"></rect>
    <text class="label" x="580" y="650">A domain</text>
    <text class="sub" x="580" y="670">calls through the client package</text>

    <!-- Flow -->
    <line class="flow" x1="290" y1="82" x2="290" y2="144"></line>
    <line class="flow" x1="490" y1="82" x2="490" y2="144"></line>
    <line class="flow" x1="170" y1="82" x2="170" y2="336"></line>

    <line class="flow" x1="390" y1="202" x2="390" y2="240"></line>
    <text class="note" x="400" y="226">writes the next version</text>

    <line class="flow" x1="390" y1="298" x2="390" y2="336"></line>
    <text class="note" x="400" y="322">the latest version</text>

    <line class="flow" x1="200" y1="410" x2="200" y2="448"></line>
    <line class="flow" x1="580" y1="410" x2="580" y2="448"></line>

    <line class="flow" x1="200" y1="514" x2="200" y2="624"></line>
    <text class="note" x="210" y="566">the gateway's stack deploys it</text>
    <line class="flow" x1="580" y1="514" x2="580" y2="624"></line>
    <text class="note" x="590" y="566">a domain installs it</text>

    <line class="flow" x1="440" y1="654" x2="342" y2="654"></line>
    <text class="note" x="391" y="646" text-anchor="middle">invokes</text>
  </svg>
</Diagram>

<style>
  .flow {
    marker-end: url(#gateway-build-arrow);
  }
</style>
