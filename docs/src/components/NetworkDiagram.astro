---
// A domain account's network: one availability zone in full, with its three tiers, the
// workloads' security groups and the interface endpoints each may reach, the private tier's route
// out, and the Resolver's DNS Firewall. Drawn with Starlight's colour variables so it follows the
// light and dark themes.
import Diagram from "./Diagram.astro";
---

<Diagram title="A domain account's network" minWidth={600} maxWidth={900}>
  <svg
    viewBox="0 0 900 900"
    role="img"
    aria-labelledby="network-title network-desc"
  >
    <title id="network-title">A domain account's network</title>
    <desc id="network-desc">
      A domain account has one VPC, 10.0.0.0/16, in eu-west-2. Its Route 53 Resolver filters names
      with DNS Firewall: at priority 1000 it allows the names on the allowlist, and at priority
      9000 it blocks every other name with NXDOMAIN. Every availability zone has the same three
      subnets, each at its own blocks; eu-west-2a is drawn. The isolated subnet, 10.0.0.0/20, has
      no route out. It holds the domain and isolated-gateway security groups, and the interface
      endpoints: lambda, secretsmanager, sts, dynamodb and execute-api. The domain group may reach
      the lambda endpoint, to invoke gateways. The isolated-gateway group may reach the
      secretsmanager, sts, dynamodb and execute-api endpoints. The private subnet, 10.0.64.0/20,
      holds the private-gateway group, which may reach the secretsmanager, sts and dynamodb
      endpoints, and its zone's NAT gateway. The NAT gateway is in the public subnet,
      10.0.128.0/24, which routes to the internet gateway, and from there to upstreams on the
      internet.
    </desc>
    <defs>
      <marker
        id="network-arrow"
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="6"
        markerHeight="6"
        orient="auto-start-reverse"
      >
        <path d="M0,0 L10,5 L0,10 z" class="head"></path>
      </marker>
    </defs>

    <!-- Account -->
    <rect class="section" x="20" y="20" width="860" height="792" rx="10"></rect>
    <text class="section-title" x="36" y="48">Domain account</text>
    <text class="note end mono" x="864" y="48">network-&lt;environment&gt;-&lt;account&gt;</text>

    <!-- VPC -->
    <rect class="box" x="36" y="64" width="828" height="732" rx="8"></rect>
    <text class="title" x="52" y="92">VPC</text>
    <text class="note mono" x="92" y="92">10.0.0.0/16</text>

    <!-- Resolver -->
    <rect class="box" x="68" y="108" width="764" height="68" rx="6"></rect>
    <text class="label" x="450" y="134">Route 53 Resolver, with DNS Firewall</text>
    <text class="sub" x="450" y="158">1000: allow the names on the allowlist · 9000: block every other name with NXDOMAIN</text>

    <!-- Availability zone -->
    <rect class="zone" x="52" y="212" width="796" height="490" rx="8"></rect>
    <text class="title mono" x="68" y="238">eu-west-2a</text>
    <text class="note end" x="832" y="238">every zone repeats this, at its own blocks</text>
    <polyline class="flow" points="700,212 700,178"></polyline>
    <text class="note" x="710" y="200">DNS queries</text>

    <!-- Isolated tier -->
    <rect class="subnet" x="68" y="252" width="764" height="232" rx="6"></rect>
    <text class="note" x="80" y="272"><tspan class="mono">isolated</tspan> · <tspan class="mono">10.0.0.0/20</tspan></text>
    <text class="note end" x="820" y="272">no route out</text>

    <rect class="box accent" x="84" y="286" width="148" height="52" rx="6"></rect>
    <text class="label mono" x="158" y="309">domain</text>
    <text class="sub" x="158" y="328">security group</text>

    <rect class="box accent" x="423" y="286" width="200" height="52" rx="6"></rect>
    <text class="label mono" x="523" y="309">isolated-gateway</text>
    <text class="sub" x="523" y="328">security group</text>

    <rect class="box" x="92" y="388" width="132" height="52" rx="6"></rect>
    <text class="label small mono" x="158" y="410">lambda</text>
    <text class="sub" x="158" y="429">invoke gateways</text>
    <rect class="box" x="238" y="388" width="132" height="52" rx="6"></rect>
    <text class="label small mono" x="304" y="410">secretsmanager</text>
    <text class="sub" x="304" y="429">gateway secrets</text>
    <rect class="box" x="384" y="388" width="132" height="52" rx="6"></rect>
    <text class="label small mono" x="450" y="410">sts</text>
    <text class="sub" x="450" y="429">assume roles</text>
    <rect class="box" x="530" y="388" width="132" height="52" rx="6"></rect>
    <text class="label small mono" x="596" y="410">dynamodb</text>
    <text class="sub" x="596" y="429">caller token keys</text>
    <rect class="box" x="676" y="388" width="132" height="52" rx="6"></rect>
    <text class="label small mono" x="742" y="410">execute-api</text>
    <text class="sub" x="742" y="429">private APIs</text>
    <text class="note" x="92" y="464">interface endpoints</text>

    <line class="flow" x1="158" y1="338" x2="158" y2="386"></line>
    <polyline class="bus" points="523,338 523,362"></polyline>
    <polyline class="bus" points="304,362 742,362"></polyline>
    <line class="flow" x1="304" y1="362" x2="304" y2="386"></line>
    <line class="flow" x1="450" y1="362" x2="450" y2="386"></line>
    <line class="flow" x1="596" y1="362" x2="596" y2="386"></line>
    <line class="flow" x1="742" y1="362" x2="742" y2="386"></line>

    <!-- Private tier -->
    <rect class="subnet" x="68" y="500" width="764" height="100" rx="6"></rect>
    <text class="note" x="80" y="520"><tspan class="mono">private</tspan> · <tspan class="mono">10.0.64.0/20</tspan></text>
    <text class="note end" x="820" y="520">route out: its zone's NAT gateway</text>

    <rect class="box accent" x="350" y="532" width="200" height="52" rx="6"></rect>
    <text class="label mono" x="450" y="555">private-gateway</text>
    <text class="sub" x="450" y="574">security group</text>

    <polyline class="bus" points="450,532 450,464"></polyline>
    <polyline class="bus" points="304,464 596,464"></polyline>
    <line class="flow" x1="304" y1="464" x2="304" y2="442"></line>
    <line class="flow" x1="450" y1="464" x2="450" y2="442"></line>
    <line class="flow" x1="596" y1="464" x2="596" y2="442"></line>

    <!-- Public tier -->
    <rect class="subnet" x="68" y="616" width="764" height="72" rx="6"></rect>
    <text class="note" x="80" y="636"><tspan class="mono">public</tspan> · <tspan class="mono">10.0.128.0/24</tspan></text>
    <text class="note end" x="820" y="636">route out: the internet gateway</text>

    <rect class="box" x="360" y="626" width="180" height="52" rx="6"></rect>
    <text class="label" x="450" y="649">NAT gateway</text>
    <text class="sub" x="450" y="668">an elastic IP address</text>

    <line class="flow" x1="450" y1="584" x2="450" y2="624"></line>

    <!-- Out of the VPC -->
    <rect class="box" x="360" y="726" width="180" height="46" rx="6"></rect>
    <text class="label" x="450" y="755">Internet gateway</text>
    <line class="flow" x1="450" y1="678" x2="450" y2="724"></line>

    <rect class="external" x="340" y="840" width="220" height="40" rx="6"></rect>
    <text class="label small" x="450" y="865">Upstreams on the internet</text>
    <line class="flow" x1="450" y1="772" x2="450" y2="838"></line>
  </svg>
  <Fragment slot="caption">
    Each workload's security group lets nothing in, and lets traffic out only on TCP port 443.
  </Fragment>
</Diagram>

<style>
  .flow {
    marker-end: url(#network-arrow);
  }
  .zone {
    fill: none;
    stroke: var(--sl-color-gray-4);
  }
</style>
