    "createUser": {
      "input": {
        "type": "object",
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "appId": {
                "type": "string",
                "description": "The Users Identifier for the GOVUK App"
              }
            },
            "required": [
              "appId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "payload"
        ],
        "additionalProperties": false
      },
      "outcomes": {
        "no_content": {
          "type": "null"
        }
      }
    },
    "getIdentityExchange": {
      "input": {
        "type": "object",
        "properties": {
          "requiredService": {
            "type": "string",
            "minLength": 1,
            "description": "The service name to look up the linked identity for"
          },
          "requestingService": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the requesting service - often the One Login relying-party name"
          },
          "requestingServiceUserId": {
            "type": "string",
            "minLength": 1,
            "description": "The user identifier used by the requesting service when linking the user to the app"
          }
        },
        "required": [
          "requiredService",
          "requestingService",
          "requestingServiceUserId"
        ],
        "additionalProperties": false
      },
      "outcomes": {
        "ok": {
          "type": "object",
          "properties": {
            "serviceId": {
              "type": "string",
              "description": "The Identifer for the requested service"
            },
            "serviceName": {
              "type": "string",
              "description": "The service name for the identity record"
            },
            "accessToken": {
              "type": "string",
              "description": "The access token for the service from one login"
            },
            "refreshToken": {
              "type": "string",
              "description": "The refresh token for the service from one login"
            },
            "idToken": {
              "type": "string",
              "description": "The idToken for the service from one login"
            }
          },
          "required": [
            "serviceId",
            "serviceName"
          ]
        }
      }
    },
