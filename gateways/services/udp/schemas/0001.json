    "createIdentity": {
      "input": {
        "type": "object",
        "properties": {
          "serviceName": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the service for which the identifier belongs"
          },
          "identifier": {
            "type": "string",
            "minLength": 1,
            "description": "The provided User Identifier for the given service"
          },
          "payload": {
            "type": "object",
            "properties": {
              "appId": {
                "type": "string",
                "description": "The Users Identifier for the GOVUK App"
              },
              "expiresAt": {
                "type": "integer",
                "exclusiveMinimum": 1776867570,
                "description": "The expiry time for the identity in EPOCH Timestamp no milliseconds, must be future dated"
              },
              "accessToken": {
                "type": "string",
                "description": "The access token for the service from one login"
              },
              "refreshToken": {
                "type": "string",
                "description": "The refresh token for the service from one login"
              },
              "idToken": {
                "type": "string",
                "description": "The idToken for the service from one login"
              }
            },
            "required": [
              "appId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "serviceName",
          "identifier",
          "payload"
        ],
        "additionalProperties": false
      },
      "outcomes": {
        "ok": {
          "type": "object",
          "properties": {
            "message": {
              "type": "string",
              "description": "Server response message"
            }
          },
          "required": [
            "message"
          ]
        }
      }
    },
