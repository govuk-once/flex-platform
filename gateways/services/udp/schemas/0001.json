      "outcomes": {
        "ok": {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "consentStatus": {
                  "anyOf": [
                    {
                      "enum": [
                        "unknown",
                        "accepted",
                        "denied"
                      ]
                    },
                    {
                      "type": "string"
                    }
                  ],
                  "description": "Whether the user has agreed to receive notifications"
                },
                "pushId": {
                  "type": "string",
                  "description": "The id notifications are pushed to"
                }
              },
              "required": [
                "consentStatus"
              ]
            }
          },
          "required": [
            "data"
          ]
        }
      }
    },
