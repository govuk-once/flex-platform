{
  "$schema": "https://turbo.build/schema.json",
  // Turbo otherwise writes guidance for AI agents into a root AGENTS.md whenever one runs it. The
  // repository's own guidance is in CLAUDE.md and the documentation site.
  "agentGuidance": false,
  // cdkApp in infra/constructs reads CDK's feature flags from the app's cdk.json by path, which no
  // package's inputs hold. As a global dependency, a flag change reruns every task, which is rare.
  "globalDependencies": ["infra/app/cdk.json"],
  "tasks": {
    "codegen": {
      "cache": false
    },
    "schemas": {
      "cache": false
    },
    // Workspace packages export their TypeScript sources, so a package's checks read its
    // dependencies' files, which Turborepo leaves out of a task's hash unless the task depends
    // on them. This task does nothing and has no script; depending on it puts every workspace
    // dependency's files in the hash, so a dependency's change invalidates a dependent's cached
    // result, without making the checks wait on each other.
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    }
  }
}
