{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "codegen": {
      "dependsOn": ["^build"],
      "inputs": ["gateway.config.ts", "schemas.fixture.ts"],
      "outputs": [".gen/**"]
    },
    "build": {
      "dependsOn": ["^build", "codegen"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "codegen"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["build"]
    }
  }
}
